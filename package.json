{
  "name": "bunnycraft",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:zones",
    "build": "npm run build -w @bunnycraft/storefront && npm run build -w @bunnycraft/admin",
    "start": "concurrently -n storefront,admin -c blue,magenta \"npm:start:storefront\" \"npm:start:admin\"",
    "lint": "npm run lint -w @bunnycraft/storefront && npm run lint -w @bunnycraft/admin",
    "db:push": "npm run db:push -w @bunnycraft/db",
    "db:migrate": "npm run db:migrate -w @bunnycraft/db",
    "db:seed": "npm run db:seed -w @bunnycraft/db",
    "db:studio": "npm run db:studio -w @bunnycraft/db",
    "dev:storefront": "npm run dev -w @bunnycraft/storefront",
    "dev:admin": "npm run dev -w @bunnycraft/admin",
    "dev:zones": "concurrently -n storefront,admin -c blue,magenta \"npm:dev:storefront\" \"npm:dev:admin\"",
    "start:storefront": "npm run start -w @bunnycraft/storefront",
    "start:admin": "npm run start -w @bunnycraft/admin"
  },
  "dependencies": {
    "@bunnycraft/db": "*"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5"
  }
}
