# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — unanchored (not "/node_modules") so this also covers any
# per-workspace node_modules under apps/* and packages/*, not just the root
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — unanchored for the same reason (apps/*/.next, packages/*/.next)
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded custom-print files (local disk storage adapter)
/uploads
