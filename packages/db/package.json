{
  "name": "@bunnycraft/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts up",
    "db:migrate:status": "tsx --env-file-if-exists=.env src/cli/migrate.ts status",
    "db:migrate:down": "tsx --env-file-if-exists=.env src/cli/migrate.ts down",
    "db:check": "tsx --env-file-if-exists=.env src/cli/check-schema.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "bcryptjs": "^3.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
