# --- Database ---
# MySQL connection string. Get a free hosted instance from Railway, Aiven, or
# PlanetScale, then paste its connection string here.
#
# Railway:      mysql://root:<password>@<host>.proxy.rlwy.net:<port>/railway
# Aiven:        mysql://avnadmin:<password>@<host>.aivencloud.com:<port>/defaultdb?ssl-mode=REQUIRED
# PlanetScale:  mysql://<user>:<password>@<host>.psdb.cloud/<db>?sslaccept=strict
DATABASE_URL="mysql://user:password@localhost:3306/bunnycraft"

# --- Auth ---
# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Multi-Zones ---
# apps/storefront's rewrites() forward /bunnycraft-admin/* to this origin.
ADMIN_ORIGIN="http://localhost:3001"
# Public URL of the admin app when it has its own hostname in production
# (e.g. https://admin.example.com). /bunnycraft-admin on the storefront then
# redirects there. Leave blank in local dev.
ADMIN_PUBLIC_URL=""

# --- Google reviews (optional) ---
# Shows your Google Business rating + latest reviews on the homepage.
# Key: Google Cloud console > enable "Places API (New)" > Credentials > API key.
# Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
# Leave blank to show the store's own reviews instead.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
