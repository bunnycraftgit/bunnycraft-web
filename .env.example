# --- Database ---
# MySQL connection string. Get a free hosted instance from Railway, Aiven, or
# PlanetScale, then paste its connection string here.
#
# Railway:      mysql://root:<password>@<host>.proxy.rlwy.net:<port>/railway
# Aiven:        mysql://avnadmin:<password>@<host>.aivencloud.com:<port>/defaultdb?ssl-mode=REQUIRED
# PlanetScale:  mysql://<user>:<password>@<host>.psdb.cloud/<db>?sslaccept=strict
DATABASE_URL="mysql://user:password@localhost:3306/bunnycraft"

# --- Auth ---
# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

